# Worker runtime variables (set on Cloudflare Worker, never hardcode secrets).
CONTACT_EMAIL=maintiflow.contact@gmail.com
# Optional Resend email alert; RESEND_API_KEY is a Cloudflare secret.
RESEND_API_KEY=
RESEND_FROM=
# Optional Turnstile: both values required if activated. Secret must stay private.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
