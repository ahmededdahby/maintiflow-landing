{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maintiflow-landing",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-16",
  "keep_vars": true,
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  // Add the real D1 database UUID (maintiflow-leads) once retrieved; do not add a fake ID.
}
