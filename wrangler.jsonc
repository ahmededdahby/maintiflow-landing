{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maintiflow-landing",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-16",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maintiflow-leads",
      "database_id": "f91ca6da-6154-459a-803f-e575f4b6ed91"
    }
  ],
  "ratelimits": [
    {
      "name": "SIGNUP_RATE_LIMIT",
      "namespace_id": "82341763",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
